{
  "expo": {
    "name": "다움테크카메라",
    "slug": "d-tech-camera",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daumtech.camera"
    },
    "android": {
      "package": "com.daumtech.camera",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-camera",
      "expo-notifications",
      [
        "expo-file-system",
        {
          "requiredPermissions": [
            "READ_EXTERNAL_STORAGE",
            "WRITE_EXTERNAL_STORAGE"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e10ae160-39a8-4e51-b3b7-07eff69dbf82"
      }
    },
    "owner": "tutelle98",
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}